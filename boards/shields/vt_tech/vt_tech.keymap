#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>[o]

#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10     if CONFIG_ZMK_POINTING_SMOOTH_SCROLLING=y default 300


&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <400>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <150>;
};


/ {

    conditional_layers {
        compatible = "zmk,conditional-layers";
    };

    keymap {
            compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none         &none            &none        &none         &none         &none                 &none         &none              &none           &none             &none           &none
&kp ESC       &kp Q            &kp W        &kp E         &kp R         &kp T                 &kp Y         &kp U              &kp I           &kp O             &kp P           &kp LBKT
&kp TAB       &kp A            &mt LCTRL S  &mt LALT D    &mt LSHFT F   &kp G                 &kp H         &mt RSHFT J        &mt RALT K      &mt RCTRL L       &kp SEMI        &kp SQT
&kp LWIN      &kp Z            &kp X        &kp C         &kp V         &kp B                 &kp N         &kp M              &kp COMMA       &kp DOT           &kp FSLH        &kp DEL
&none         &none            &kp TILDE    &kp MINUS     &none         &tog 5                &none         &none              &kp K_BACK      &kp K_FORWARD     &none           &none
&none         &mo 1            &mo 2        &kp K_CUT     &kp SPACE     &kp ENTER             &kp ENTER     &kp SPACE          &kp BSPC        &mo 3             &mo 4           &none
            >;
        };

        layer_1 {
            bindings = <
&none         &none            &none        &none         &none         &none                 &none         &none              &none           &none             &none           &none
&trans        &kp F1           &kp F2       &kp F3        &kp F4        &kp F5                &trans        &trans             &trans          &trans            &trans          &trans
&trans        &kp F6           &kp F7       &kp F8        &kp F9        &kp F10                &trans        &trans             &trans          &trans            &trans          &trans
&trans        &kp F11          &kp F12      &kp F13       &kp F14       &kp F15                &trans        &trans             &trans          &trans            &trans          &trans
&none         &none            &kp F16      &kp F17       &none         &trans                 &none         &none              &trans          &trans            &none           &none
&none         &trans           &trans       &trans        &trans        &trans                &trans        &trans             &trans          &trans            &trans          &none
            >;
        };

        layer_2 {
            bindings = <
&none         &none            &none        &none         &none         &none                 &none         &none              &none           &none             &none           &none
&trans        &kp EXCL         &kp AT       &kp POUND     &kp DLLR      &kp PRCNT             &kp KP_LPAR   &kp KP_RPAR        &kp LBRC        &kp RBRC          &kp PIPE        &kp BACKSLASH
&trans        &kp CARET        &kp AMPS     &kp GRAVE     &trans        &trans                &kp LBKT      &kp RBKT           &trans          &trans            &trans          &trans
&trans        &trans           &trans       &trans        &trans        &trans                &trans        &trans             &trans          &trans            &trans          &trans
&none         &none            &trans       &trans        &none         &trans                &none         &none              &trans          &trans            &none           &none
&none         &trans           &trans       &trans        &trans        &trans                &trans        &trans             &trans          &trans            &trans          &none
            >;
        };

        layer_3 {
            bindings = <
&none         &none            &none        &none         &none         &none                 &none         &none              &none           &none             &none           &none
&trans        &kp KP_PLUS      &kp KP_N7    &kp KP_N8     &kp KP_N9     &kp KP_ASTERISK       &trans        &kp HOME           &kp UP          &trans            &trans          &kp PSCRN
&trans        &kp KP_MINUS     &kp KP_N4    &kp KP_N5     &kp KP_N6     &kp KP_SLASH          &trans        &kp LEFT           &kp DOWN        &kp RIGHT         &trans          &trans
&kp ENTER     &trans           &kp KP_N1    &kp KP_N2     &kp KP_N3     &kp EQUAL             &trans        &trans             &trans          &trans            &trans          &trans
&none         &none            &kp COMMA    &kp KP_N0     &none         &trans                &none         &none              &trans          &trans            &none           &none
&none         &trans           &trans       &trans        &trans        &trans                &trans        &trans             &trans          &trans            &trans          &none
            >;
        };

        layer_4 {
            bindings = <
&none         &none            &none        &none         &none         &none                 &none         &none              &none           &none             &none           &none
&trans        &trans           &trans       &trans        &trans        &trans                &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2    &bt BT_SEL 3      &bt BT_SEL 4    &bt BT_CLR_ALL
&trans        &trans           &trans       &trans        &trans        &trans                &bt BT_CLR    &bt BT_PRV         &bt BT_NXT      &trans            &trans          &trans
&trans        &trans           &trans       &trans        &trans        &trans                &trans        &kp C_PREV         &kp C_PP        &kp C_NEXT        &trans          &trans
&none         &none            &trans       &trans        &none         &trans                &kp KP_NUM    &none              &kp C_VOL_DN    &kp C_VOL_UP      &none           &none
&none         &trans           &trans       &trans        &trans        &trans                &trans        &trans             &trans          &trans            &trans          &none
            >;
        };

        layer_5 {
            bindings = <
&none         &none            &none        &none         &none         &none                 &none         &none              &none           &none             &none           &none
&trans        &kp T            &kp Q        &kp W         &kp E         &kp R                 &trans        &trans             &kp UP          &trans            &trans          &trans
&trans        &kp G            &kp A        &kp S         &kp D         &kp F                 &trans        &kp LEFT           &kp DOWN        &kp RIGHT         &trans          &trans
&kp F5        &kp B            &kp Z        &kp X         &kp C         &kp V                 &trans        &trans             &trans          &trans            &trans          &trans
&none         &none            &trans       &kp ENTER     &none         &trans                &none         &none              &kp C_VOL_DN    &kp C_VOL_UP      &none           &none
&none         &mo 6            &kp LSHFT    &kp LCTRL     &kp LALT      &kp SPACE             &trans        &trans             &trans          &trans            &trans          &none
            >;
        };

        layer_6 {
            bindings = <
&none         &none            &none        &none         &none         &none                 &none         &none              &none           &none             &none           &none
&trans        &kp KP_N1        &kp KP_N2    &kp KP_N3     &kp KP_N4     &kp KP_N5             &trans        &trans             &trans          &trans            &trans          &trans
&trans        &kp F1           &kp F2       &kp F3        &kp F4        &kp F5                &trans        &trans             &trans          &trans            &trans          &trans
&trans        &trans           &trans       &trans        &trans        &trans                &trans        &trans             &trans          &trans            &trans          &trans
&none         &none            &trans       &trans        &none         &trans                &none         &none              &trans          &trans            &none           &none
&none         &trans           &trans       &trans        &trans        &trans                &trans        &trans             &trans          &trans            &trans          &none
            >;
       };
    };
};
